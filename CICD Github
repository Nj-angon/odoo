1️⃣3️⃣ Optional (Better Production)

Better approach:

Instead of restart Odoo always:

./odoo-bin -u module_name -d db_name

Example:

./odoo-bin -u sale_custom_discount -d production_db


#for local pc
name: Odoo CI/CD Pipeline

on:
  push:
    branches:
      - main

jobs:

  # ==========================
  # CI TEST JOB (GitHub Server)
  # ==========================

  test:
    runs-on: ubuntu-latest

    services:
      postgres:
        image: postgres:14
        env:
          POSTGRES_USER: odoo
          POSTGRES_PASSWORD: odoo
          POSTGRES_DB: postgres
        ports:
          - 5432:5432

    steps:
      - uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: 3.10

      - name: Install Dependencies
        run: |
          if [ -f requirements.txt ]; then
            pip install -r requirements.txt
          fi

      - name: CI Validation Step
        run: echo "CI Test Passed"

  # ==========================
  # DEPLOY JOB (Production PC)
  # ==========================

  deploy:
    needs: test
    runs-on: self-hosted

    steps:
      - name: Pull Latest Code
        run: |
          cd /opt/odoo16/odoo16/odoo-custom-addons
          git pull origin main

      - name: Restart Odoo Service
        run: |
          sudo systemctl restart odoo16

      - name: Deployment Completed
        run: echo "Deployment Success"
