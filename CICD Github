1️⃣3️⃣ Optional (Better Production)

Better approach:

Instead of restart Odoo always:

./odoo-bin -u module_name -d db_name

Example:

./odoo-bin -u sale_custom_discount -d production_db


#for local pc---------------------------------

name: Odoo CI/CD Pipeline

on:
  push:
    branches:
      - main

jobs:

  # ==========================
  # CI TEST JOB (GitHub Server)
  # ==========================

  test:
    runs-on: ubuntu-latest

    steps:

      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: 3.12

      # -----------------------
      # Install dependencies
      # -----------------------

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          if [ -f requirements.txt ]; then
            pip install -r requirements.txt
          fi
      # -----------------------
      # Install Code Quality Tools
      # -----------------------

      - name: Install Lint Tools
        run: |
          pip install flake8 pylint pylint-odoo black
      # -----------------------
      # Python Syntax Check
      # -----------------------

      - name: Check Python Syntax
        run: |
          python -m py_compile $(git ls-files '*.py')
      # -----------------------
      # Run flake8
      # -----------------------

      - name: Run flake8
        run: |
          flake8 . --max-line-length=120 --ignore=F401,W292,W391,E265,E741,E302
      # -----------------------
      # Run pylint-odoo
      # -----------------------

      - name: Run pylint-odoo
        run: |
          pylint --load-plugins=pylint_odoo hr_owner_share || true
      - name: CI Test Passed
        run: echo "Code Quality Checks Passed"


  # ==========================
  # DEPLOY JOB (Production Server)
  # ==========================

  deploy:
    needs: test
    runs-on: self-hosted

    steps:

      - name: Pull Latest Code
        run: |
          cd /opt/odoo16/odoo16/odoo-custom-addons
          git pull origin main
      - name: Restart Odoo Service
        run: |
          sudo systemctl restart odoo16
      - name: Upgrade Module
        run: |
          source /opt/odoo16/env/bin/activate
          cd /opt/odoo16/odoo16
          ./odoo-bin -d TEST_cicd \
          -u hr_owner_share \
          --db_host=localhost \
          --db_port=5432 \
          --db_user=odoo \
          --db_password=12345 \
          --stop-after-init
      - name: Deployment Completed
        run: echo "Deployment Success"
